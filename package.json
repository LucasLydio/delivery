{
  "name": "delivery",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run start",
    "dev:backend": "node --env-file=.env.dev --import tsx backend/dev.ts",
    "build": "npm run prisma:generate && npm run typecheck:backend && ng build",
    "build:dev": "npm run prisma:generate:dev && npm run typecheck:backend && ng build",
    "build:prod": "npm run prisma:generate:prod && npm run typecheck:backend && ng build",
    "build:frontend": "ng build",
    "typecheck:backend": "tsc --noEmit --project backend/tsconfig.json",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:generate:dev": "prisma generate --config prisma.config.dev.ts",
    "prisma:generate:prod": "prisma generate --config prisma.config.prod.ts",
    "prisma:validate:dev": "prisma validate --config prisma.config.dev.ts",
    "prisma:validate:prod": "prisma validate --config prisma.config.prod.ts",
    "prisma:status:dev": "prisma migrate status --config prisma.config.dev.ts",
    "prisma:status:prod": "prisma migrate status --config prisma.config.prod.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.dev.ts",
    "prisma:migrate:prod": "prisma migrate deploy --config prisma.config.prod.ts",
    "prisma:seed:dev": "prisma db seed --config prisma.config.dev.ts",
    "dev:netlify": "node scripts/netlify-dev.mjs api",
    "dev:netlify:full": "node scripts/netlify-dev.mjs full",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:backend": "tsx --test \"backend/**/*.spec.ts\"",
    "test:backend:db": "node --env-file-if-exists=.env.dev --import tsx --test \"backend/**/*.db.test.ts\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "@netlify/functions": "^4.0.0",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "express": "^5.3.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "redis": "^5.12.1",
    "rxjs": "~7.8.0",
    "serverless-http": "^4.0.0",
    "tslib": "^2.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.39",
    "@angular/cli": "^20.3.39",
    "@angular/compiler-cli": "^20.3.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.2.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "netlify-cli": "^23.0.0",
    "prisma": "6.19.0",
    "supertest": "^7.3.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
