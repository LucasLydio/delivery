generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model StateSnapshot {
  id        String   @id @default(cuid())
  state     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("state_snapshots")
}

model PushSubscription {
  id        String   @id @default(cuid())
  customerId String?  @map("customer_id")
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  installId String   @map("install_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([installId])
  @@index([customerId, updatedAt])
  @@map("push_subscriptions")
}

// One brand is deployed with one database. Product labels are localized content;
// slugs and IDs remain stable across text changes.
model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("categories")
}

// Catalog writes must increment this singleton in the same transaction so the
// API can use its version as the ETag for cached product data.
model CatalogRevision {
  id        String   @id
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("catalog_revision")
}

model Product {
  id             String               @id @default(cuid())
  slug           String               @unique
  name           String
  description    String
  categoryId     String               @map("category_id")
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  basePriceMinor Int                  @map("base_price_minor")
  currency       String               @db.VarChar(3)
  available      Boolean              @default(true)
  sortOrder      Int                  @default(0) @map("sort_order")
  images         ProductImage[]
  optionGroups   ProductOptionGroup[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([categoryId, available, sortOrder])
  @@map("products")
}

// The object key is durable; the local-folder or Supabase URL is derived at read time.
model ProductImage {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey String   @unique @map("storage_key")
  alt        String
  mimeType   String   @map("mime_type") @db.VarChar(64)
  width      Int?
  height     Int?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductOptionGroup {
  id            String          @id @default(cuid())
  productId     String          @map("product_id")
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  minSelections Int             @default(0) @map("min_selections")
  maxSelections Int             @default(1) @map("max_selections")
  sortOrder     Int             @default(0) @map("sort_order")
  options       ProductOption[]

  @@index([productId, sortOrder])
  @@map("product_option_groups")
}

model ProductOption {
  id               String             @id @default(cuid())
  groupId          String             @map("group_id")
  group            ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name             String
  priceDeltaMinor  Int                @default(0) @map("price_delta_minor")
  available        Boolean            @default(true)
  sortOrder        Int                @default(0) @map("sort_order")
  cartSelections   CartItemOption[]
  orderSelections  OrderItemOption[]

  @@index([groupId, sortOrder])
  @@map("product_options")
}

// loginName and phone form the first-party, low-friction customer identity.
// loginName remains nullable so existing rows can be upgraded on their first login.
model Customer {
  id          String            @id @default(cuid())
  authSubject String?           @unique @map("auth_subject")
  loginName   String?           @map("login_name")
  name        String
  email       String?
  phone       String?           @unique
  sessions    CustomerSession[]
  pushSubscriptions PushSubscription[]
  addresses   Address[]
  cart        Cart?
  orders      Order[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("customers")
}

// Refresh tokens are opaque. Only their SHA-256 hashes are persisted. A family
// lets the service revoke every descendant when a rotated token is replayed.
model CustomerSession {
  id        String    @id @default(cuid())
  customerId String   @map("customer_id")
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("customer_sessions")
}

enum UserProfile {
  ADMIN
  MANAGER
}

// Back-office users are independent from delivery customers. Passwords are
// persisted only as salted hashes and refresh sessions can be revoked/rotated.
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  profile      UserProfile   @default(MANAGER)
  passwordHash String        @map("password_hash")
  sessions     UserSession[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([profile, name])
  @@map("users")
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model Address {
  id                   String   @id @default(cuid())
  customerId           String   @map("customer_id")
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label                String
  line1                String
  line2                String?
  city                 String
  region               String?
  postalCode           String   @map("postal_code")
  countryCode          String   @map("country_code") @db.VarChar(2)
  deliveryInstructions String?  @map("delivery_instructions")
  locationPin          Json?    @map("location_pin")
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("addresses")
}

// A cart belongs to either one customer or one signed guest token. The migration
// enforces that exactly one identity is present.
model Cart {
  id             String     @id @default(cuid())
  customerId     String?    @unique @map("customer_id")
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestTokenHash String?    @unique @map("guest_token_hash")
  revision       Int        @default(1)
  currency       String     @db.VarChar(3)
  items          CartItem[]
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id              String           @id @default(cuid())
  cartId          String           @map("cart_id")
  cart            Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String           @map("product_id")
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Int
  selectedOptions CartItemOption[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model CartItemOption {
  cartItemId String        @map("cart_item_id")
  cartItem   CartItem      @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  optionId   String        @map("option_id")
  option     ProductOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([cartItemId, optionId])
  @@index([optionId])
  @@map("cart_item_options")
}

// Only a draft state exists until checkout placement and payment are specified.
enum OrderStatus {
  DRAFT
  PAYMENT_PENDING
  CONFIRMED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentMethod {
  MERCADO_PAGO_PIX
  MERCADO_PAGO_CARD
  PAY_ON_DELIVERY
  PAY_AT_STORE
}

enum PaymentStatus {
  PENDING
  PAID
  ON_DELIVERY
  AT_STORE
  FAILED
  CANCELLED
}

model Order {
  id                 String      @id @default(cuid())
  customerId         String?     @map("customer_id")
  customer           Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status             OrderStatus @default(DRAFT)
  paymentMethod      PaymentMethod? @map("payment_method")
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  currency           String      @db.VarChar(3)
  cartRevision       Int?        @map("cart_revision")
  subtotalMinor      Int         @default(0) @map("subtotal_minor")
  deliveryFeeMinor   Int?        @map("delivery_fee_minor")
  paymentFeeMinor    Int         @default(0) @map("payment_fee_minor")
  discountPercent    Int         @default(0) @map("discount_percent")
  discountMinor      Int         @default(0) @map("discount_minor")
  couponCode         String?     @map("coupon_code")
  taxMinor           Int?        @map("tax_minor")
  totalMinor         Int?        @map("total_minor")
  distanceMeters     Int?        @map("distance_meters")
  deliveryAddress    Json?       @map("delivery_address")
  quoteExpiresAt     DateTime?   @map("quote_expires_at")
  idempotencyKey     String?     @unique @map("idempotency_key")
  mercadoPagoOrderId String?     @unique @map("mercado_pago_order_id")
  mercadoPagoStatus  String?     @map("mercado_pago_status")
  paymentData        Json?       @map("payment_data")
  paymentExpiresAt   DateTime?   @map("payment_expires_at")
  confirmedAt        DateTime?   @map("confirmed_at")
  cancelledAt        DateTime?   @map("cancelled_at")
  items              OrderItem[]
  events             OrderEvent[]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([status, paymentExpiresAt])
  @@map("orders")
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int      @map("discount_percent")
  active          Boolean  @default(true)
  startsAt        DateTime? @map("starts_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([active, startsAt, expiresAt])
  @@map("coupons")
}

model DeliveryPricingSetting {
  id            String   @id
  limitKm       Decimal  @map("limit_km") @db.Decimal(8, 3)
  feePerKmMinor Int      @map("fee_per_km_minor")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("delivery_pricing_settings")
}

model OrderEvent {
  id         BigInt   @id @default(autoincrement())
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id")
  type       String   @db.VarChar(64)
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId, id])
  @@index([orderId, id])
  @@index([createdAt])
  @@map("order_events")
}

// Product and option references are optional so immutable snapshots survive
// catalog cleanup. The name and price columns are the historical source.
model OrderItem {
  id              String            @id @default(cuid())
  orderId         String            @map("order_id")
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId       String?           @map("product_id")
  product         Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  name            String
  quantity        Int
  unitPriceMinor  Int               @map("unit_price_minor")
  lineTotalMinor  Int               @map("line_total_minor")
  sortOrder       Int               @default(0) @map("sort_order")
  selectedOptions OrderItemOption[]

  @@index([orderId, sortOrder])
  @@index([productId])
  @@map("order_items")
}

model OrderItemOption {
  id              String         @id @default(cuid())
  orderItemId     String         @map("order_item_id")
  orderItem       OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionId        String?        @map("option_id")
  option          ProductOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  name            String
  priceDeltaMinor Int            @map("price_delta_minor")

  @@index([orderItemId])
  @@index([optionId])
  @@map("order_item_options")
}
