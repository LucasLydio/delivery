# Local: PostgreSQL on your computer. Production: Supabase pooled connection URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivery
# Optional exact origins, comma separated. Same-origin calls do not require CORS.
CORS_ORIGIN=http://localhost:8888,http://localhost:4200
# Public VAPID key only. Configure a private key and sender when push delivery is added.
VAPID_PUBLIC_KEY=
