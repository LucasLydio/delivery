# Local: PostgreSQL on your computer. Production: Supabase pooled connection URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivery
# Optional: the products API reads directly from PostgreSQL if Redis is unavailable.
REDIS_URL=redis://localhost:6379
# Use a distinct namespace for each deployed brand/environment sharing Redis.
CACHE_NAMESPACE=delivery-dev
CATALOG_CURRENCY=BRL
# Use local for development and supabase for the production public bucket.
STORAGE_PROVIDER=local
PRODUCT_IMAGE_BASE_URL=/images/products/
LOCAL_PRODUCT_IMAGE_DIRECTORY=public/images/products
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=product-images
# Optional exact origins, comma separated. Same-origin calls do not require CORS.
CORS_ORIGIN=http://localhost:8888,http://localhost:4200
# Public VAPID key only. Configure a private key and sender when push delivery is added.
VAPID_PUBLIC_KEY=
# At least 32 random characters. Use a different secret in every environment/brand.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TOKEN_ISSUER=delivery-api
AUTH_TOKEN_AUDIENCE=delivery-pwa
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=delivery_refresh
# Admin sessions use a separate audience and cookie. Set a distinct secret in production;
# when omitted locally, the backend falls back to AUTH_TOKEN_SECRET.
ADMIN_AUTH_TOKEN_SECRET=
ADMIN_AUTH_TOKEN_AUDIENCE=delivery-admin
ADMIN_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_AUTH_REFRESH_TOKEN_TTL_DAYS=30
ADMIN_AUTH_REFRESH_COOKIE_NAME=delivery_admin_refresh
# Flat temporary delivery fee in centavos. Replace with delivery-area rules during checkout work.
CART_DELIVERY_FEE_MINOR=0
CART_QUOTE_TTL_SECONDS=300
# Delivery settings use database values when the singleton admin setting exists.
LIMIT_KM=5
FEE_PER_KM=2.50
MERCADO_PAGO_FEE_PERCENT=4.99
SHOP_LATITUDE=-23.550520
SHOP_LONGITUDE=-46.633308
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_API_URL=https://api.mercadopago.com
CHECKOUT_LOCK_TTL_MS=15000
UNPAID_ORDER_TIMEOUT_MINUTES=5
